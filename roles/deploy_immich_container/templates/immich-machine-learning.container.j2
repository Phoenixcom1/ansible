# Immich Machine Learning Container
#
# This file is managed by Ansible - DO NOT EDIT MANUALLY
# Role: deploy_immich_container

[Unit]
Description=Immich Machine Learning
Documentation=https://immich.app/docs
PartOf={{ immich_systemd_target }}
After={{ immich_network }}-network.service immich-postgres.service immich-redis.service
Wants={{ immich_network }}-network.service immich-postgres.service immich-redis.service

[Container]
Image={{ immich_ml_image }}
ContainerName={{ immich_ml_container }}
AutoUpdate=registry

# Environment from file
EnvironmentFile={{ immich_env_file }}

# ML Configuration
Environment=MACHINE_LEARNING_WORKERS={{ immich_ml_workers }}
Environment=MACHINE_LEARNING_MODEL_TTL={{ immich_ml_model_ttl }}

# ML Hardware acceleration with OpenVINO (Intel GPU)
{% if immich_enable_hardware_acceleration | bool %}
AddDevice={{ immich_gpu_device }}

# GPU group access
PodmanArgs=--gidmap=0:0:1 --gidmap=1:3:{{ video_gid | int - 1 }} --gidmap={{ video_gid }}:1:1 --gidmap={{ video_gid | int + 1 }}:{{ video_gid | int + 2 }}:{{ render_gid | int - video_gid | int - 1 }} --gidmap={{ render_gid }}:2:1 --gidmap={{ render_gid | int + 1 }}:{{ render_gid | int + 1 }}:{{ 65536 - render_gid | int }} --group-add={{ video_gid }} --group-add={{ render_gid }}
{% endif %}

# Volume for model cache
Volume={{ immich_model_cache_dir }}:/cache:Z

# Network
Network={{ immich_network }}.network

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy={{ immich_systemd_target }}
