server {
    {% if nginx_listen_ip | default('') %}
    listen {{ nginx_listen_ip }}:443 ssl http2;
    listen [{{ nginx_listen_ip }}]:443 ssl http2;
    {% else %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    {% endif %}

    server_name {{ immich_domain }};

    ssl_certificate     {{ ssl_cert }};
    ssl_certificate_key {{ ssl_key }};

    # Allow large file uploads (photos/videos)
    client_max_body_size {{ immich_max_upload_size }}M;

    # Proxy to Immich server
    location / {
        proxy_pass http://127.0.0.1:{{ immich_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Disable buffering for better streaming performance
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

server {
    {% if nginx_listen_ip | default('') %}
    listen {{ nginx_listen_ip }}:80;
    listen [{{ nginx_listen_ip }}]:80;
    {% else %}
    listen 80;
    listen [::]:80;
    {% endif %}

    server_name {{ immich_domain }};

    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}
