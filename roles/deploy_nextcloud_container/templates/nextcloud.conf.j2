server {
    {% if nginx_listen_ip | default('') %}
    listen {{ nginx_listen_ip }}:443 ssl;
    listen [{{ nginx_listen_ip }}]:443 ssl;
    {% else %}
    listen 443 ssl;
    listen [::]:443 ssl;
    {% endif %}
    http2 on;

    server_name {{ nextcloud_domain }};

    ssl_certificate     {{ ssl_cert }};
    ssl_certificate_key {{ ssl_key }};
    add_header Strict-Transport-Security "max-age={{ nextcloud_hsts_max_age }}" always;

    # Nextcloud reverse proxy
    location / {
        proxy_pass http://127.0.0.1:{{ nextcloud_port }};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;

        # WebSocket support (Talk, etc.)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Timeouts for large uploads
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Nextcloud recommends up to 10G for uploads
        client_max_body_size 10G;
    }
}

server {
    {% if nginx_listen_ip | default('') %}
    listen {{ nginx_listen_ip }}:80;
    listen [{{ nginx_listen_ip }}]:80;
    {% else %}
    listen 80;
    listen [::]:80;
    {% endif %}

    server_name {{ nextcloud_domain }};
    return 301 https://$host$request_uri;
}
