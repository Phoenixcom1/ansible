server {
    {% if nginx_listen_ip | default('') %}
    listen {{ nginx_listen_ip }}:443 ssl http2;
    listen [{{ nginx_listen_ip }}]:443 ssl http2;
    {% else %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    {% endif %}

    server_name {{ nextcloud_domain }};

    ssl_certificate     {{ ssl_cert }};
    ssl_certificate_key {{ ssl_key }};

    # Nextcloud AIO (Apache container behind external nginx reverse proxy)
    client_max_body_size {{ nextcloud_upload_max_size }};
    proxy_request_buffering off;

    location / {
        proxy_pass https://{{ nextcloud_aio_apache_bind_ip }}:{{ nextcloud_aio_apache_port }};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port 443;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # AIO Apache container uses TLS internally
        proxy_ssl_verify off;

        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # DAV service discovery redirects
    location = /.well-known/carddav {
        return 301 /remote.php/dav;
    }

    location = /.well-known/caldav {
        return 301 /remote.php/dav;
    }
}

server {
    {% if nginx_listen_ip | default('') %}
    listen {{ nginx_listen_ip }}:80;
    listen [{{ nginx_listen_ip }}]:80;
    {% else %}
    listen 80;
    listen [::]:80;
    {% endif %}

    server_name {{ nextcloud_domain }};
    return 301 https://$host$request_uri;
}
