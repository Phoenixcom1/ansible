# Nextcloud Container
# This file is managed by Ansible - DO NOT EDIT MANUALLY
# Role: deploy_nextcloud_container

[Unit]
Description=Nextcloud Web Application
Documentation=https://nextcloud.com/
After={{ nextcloud_network }}.network {{ nextcloud_postgres_container }}.service {{ nextcloud_redis_container }}.service
Wants={{ nextcloud_network }}.network {{ nextcloud_postgres_container }}.service {{ nextcloud_redis_container }}.service
{% if nextcloud_data_external | bool %}
RequiresMountsFor={{ nextcloud_data_dir }}
{% endif %}

[Container]
Image={{ nextcloud_image }}
ContainerName={{ nextcloud_container }}
AutoUpdate=registry
Pull={{ nextcloud_pull_policy }}

EnvironmentFile={{ nextcloud_env_file }}

Volume={{ nextcloud_html_dir }}:/var/www/html:Z
{% if nextcloud_data_external | bool %}
Volume={{ nextcloud_data_dir }}:/var/www/html/data
UserNS={{ nextcloud_external_data_userns }}
AddCapability=CAP_NET_BIND_SERVICE
{% endif %}
Volume={{ nextcloud_repo_path }}/nextcloud-redis.config.php:/var/www/html/config/redis.config.php:Z

Network={{ nextcloud_network }}.network
{% if nextcloud_dns_server | length > 0 %}
DNS={{ nextcloud_dns_server }}
{% endif %}
{% if nextcloud_enable_eurooffice and (nextcloud_eurooffice_internal_host_alias_enabled | bool) %}
AddHost={{ nextcloud_eurooffice_domain }}:{{ nextcloud_host_containers_internal_ip }}
{% endif %}
PublishPort=127.0.0.1:{{ nextcloud_port }}:{{ nextcloud_internal_port }}

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy={{ nextcloud_systemd_target }}
