version: "3.8"

services:
  broker:
    image: docker.io/library/redis:7
    container_name: paperless-redis
    networks:
      - {{ paperless_network }}
    restart: unless-stopped
    volumes:
      - {{ paperless_redis_dir }}:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 30s
      timeout: 3s
      retries: 3

  webserver:
    image: ghcr.io/paperless-ngx/paperless-ngx:latest
    container_name: paperless-webserver
    networks:
      - {{ paperless_network }}
    restart: unless-stopped
    depends_on:
      - broker
    ports:
      - "127.0.0.1:{{ paperless_port }}:{{ paperless_internal_port }}/tcp"
    healthcheck:
      test: ["CMD", "curl", "-fs", "-S", "--max-time", "2", "http://localhost:{{ paperless_internal_port }}"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    volumes:
      - {{ paperless_data_dir }}:/usr/src/paperless/data
      - {{ paperless_media_dir }}:/usr/src/paperless/media
      - {{ paperless_export_dir }}:/usr/src/paperless/export
      - {{ paperless_consume_dir }}:/usr/src/paperless/consume
{% if paperless_scripts_dir is defined %}
      - {{ paperless_scripts_dir }}:/usr/src/paperless/scripts
{% endif %}
{% if paperless_custom_init_dir is defined %}
      - {{ paperless_custom_init_dir }}:/custom-cont-init.d:ro
{% endif %}
    env_file: paperless.env
    environment:
      # URL configuration for CSRF protection
      - PAPERLESS_URL=https://{{ paperless_domain }}
      
      # Redis configuration (not in env file)
      - PAPERLESS_REDIS={{ paperless_redis_url }}
      
      # Tika integration (container-specific URLs)
      - PAPERLESS_TIKA_ENABLED={{ paperless_tika_enabled | int }}
      - PAPERLESS_TIKA_GOTENBERG_ENDPOINT={{ paperless_tika_gotenberg_endpoint }}
      - PAPERLESS_TIKA_ENDPOINT={{ paperless_tika_endpoint }}
      
      # Consumer settings
      - PAPERLESS_CONSUMER_DELETE_DUPLICATES={{ paperless_consumer_delete_duplicates | lower }}
      # Enable polling for network mounts (inotify doesn't work on CIFS/SMB)
      - PAPERLESS_CONSUMER_POLLING={{ paperless_consumer_polling | default(0) | int }}
      - PAPERLESS_CONSUMER_POLLING_DELAY={{ paperless_consumer_polling_delay | default(5) | int }}

  gotenberg:
    image: docker.io/gotenberg/gotenberg:latest
    container_name: paperless-gotenberg
    networks:
      - {{ paperless_network }}
    restart: unless-stopped
    command:
      - "gotenberg"
      - "--chromium-disable-javascript={{ gotenberg_chromium_disable_javascript | lower }}"
      - "--chromium-allow-list={{ gotenberg_chromium_allow_list }}"
      - "--libreoffice-disable-routes={{ gotenberg_libreoffice_disable_routes | lower }}"
      - "--libreoffice-auto-start={{ gotenberg_libreoffice_auto_start | lower }}"
      - "--libreoffice-start-timeout={{ gotenberg_libreoffice_start_timeout }}"
      - "--api-timeout={{ gotenberg_api_timeout }}"

  tika:
    image: docker.io/apache/tika:latest
    container_name: paperless-tika
    networks:
      - {{ paperless_network }}
    restart: unless-stopped

networks:
  {{ paperless_network }}:
    external: true
