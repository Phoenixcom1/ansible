version: '3.8'

services:
  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    environment:
      HOMEPAGE_ALLOWED_HOSTS: {{ homepage_allowed_hosts }}
    networks:
      - podman_bridge
    ports:
      - 127.0.0.1:3000:3000
    volumes:
      - {{ homepage_config_dir }}:/app/config
    restart: unless-stopped
    env_file:
      - {{ homepage_config_dir }}/.env
    # Use keep-id to maintain user namespace mapping for ping capability
    userns_mode: "keep-id"
    # Add NET_RAW capability to allow ping (ICMP)
    cap_add:
      - NET_RAW
    # Run container as the podman user (UID:GID dynamically discovered)
    user: "{{ podman_user_uid }}:{{ podman_user_gid }}"

networks:
  podman_bridge:
    external: true
