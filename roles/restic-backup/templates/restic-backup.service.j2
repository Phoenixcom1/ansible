[Unit]
Description=Restic backup for Podman containers
After=network-online.target
Wants=network-online.target
{% if restic_nas_enabled %}
After=mnt-backup.mount
Requires=mnt-backup.mount
{% endif %}

[Service]
Type=oneshot
ExecStart=/opt/scripts/restic-backup.sh
User={{ restic_backup_user }}
Group={{ restic_backup_group }}

# Security settings
PrivateTmp=yes
NoNewPrivileges=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=restic-backup

# Timeout: rely on the script's own per-destination timeouts (which fail
# just that destination, not the whole run) rather than a blunt service-wide
# cutoff - a large first-time backup to a new destination can legitimately
# run for hours. Override restic_service_timeout_seconds if you want a hard
# service-level cap instead.
TimeoutStartSec={{ restic_service_timeout_seconds }}
