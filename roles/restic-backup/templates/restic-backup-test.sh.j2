#!/bin/bash
# Restic backup test script - Tests stop/restart logic only
# Generated by Ansible - Do not edit manually

set -euo pipefail

echo "=========================================="
echo "Restic backup TEST started: $(date)"
echo "Testing stop/restart logic only"
echo "=========================================="

# Track stopped containers for restart
declare -a STOPPED_SERVICES=()

# Pre-backup actions (stop services)
echo ""
echo "Testing service stop logic..."

{% for service_name, service_config in restic_backup_services.items() %}
{% if service_config.enabled and service_config.get('stop_before_backup', False) %}
# {{ service_name }}: Stop compose stack for safe database backup
COMPOSE_FILE="{{ service_config.compose_file }}"
PROJECT_NAME="{{ service_config.project_name }}"
echo "Stopping {{ service_name }} (project: {% raw %}${PROJECT_NAME}{% endraw %}) for safe backup..."
if [ -f "{% raw %}${COMPOSE_FILE}{% endraw %}" ]; then
    su - {{ podman_username }} -c "podman-compose -f {% raw %}${COMPOSE_FILE}{% endraw %} --project-name {% raw %}${PROJECT_NAME}{% endraw %} down" || {
        echo "⚠ Warning: Failed to stop {% raw %}${PROJECT_NAME}{% endraw %}, backup may be inconsistent"
    }
    STOPPED_SERVICES+=("{% raw %}${COMPOSE_FILE}|${PROJECT_NAME}{% endraw %}")
    echo "✓ {{ service_name }} stopped"
else
    echo "⚠ Warning: Compose file {% raw %}${COMPOSE_FILE}{% endraw %} not found, skipping {{ service_name }} stop"
fi
{% endif %}
{% endfor %}

echo ""
echo "Stopped services count: {% raw %}${#STOPPED_SERVICES[@]}{% endraw %}"
echo ""

# Simulate backup (sleep instead of actual backup)
echo "Simulating backup (5 second delay)..."
sleep 5
echo "✓ Simulated backup completed"

# Restart stopped services
if [ {% raw %}${#STOPPED_SERVICES[@]}{% endraw %} -gt 0 ]; then
    echo ""
    echo "Restarting stopped services..."
    for SERVICE_INFO in "${STOPPED_SERVICES[@]}"; do
        COMPOSE_FILE="${SERVICE_INFO%%|*}"
        PROJECT_NAME="{% raw %}${SERVICE_INFO##*|}{% endraw %}"
        echo "Starting project {% raw %}${PROJECT_NAME}{% endraw %}..."
        su - {{ podman_username }} -c "podman-compose -f {% raw %}${COMPOSE_FILE}{% endraw %} --project-name {% raw %}${PROJECT_NAME}{% endraw %} up -d" || {
            echo "⚠ ERROR: Failed to restart {% raw %}${PROJECT_NAME}{% endraw %}!"
        }
        echo "✓ {% raw %}${PROJECT_NAME}{% endraw %} restarted"
    done
else
    echo "No services to restart"
fi

echo ""
echo "=========================================="
echo "Restic backup TEST completed: $(date)"
echo "=========================================="
