#!/bin/bash
# Restic backup script for Podman containers
# Generated by Ansible - Do not edit manually

set -euo pipefail

# Configuration
RESTIC_REPOSITORY="{{ restic_repository }}"
RESTIC_PASSWORD_FILE="{{ restic_password_file }}"

# Logging
LOG_FILE="/var/log/restic-backup.log"
exec 1> >(tee -a "$LOG_FILE")
exec 2>&1

echo "=========================================="
echo "Restic backup started: $(date)"
echo "=========================================="

# Check if repository is accessible
if [ ! -d "$(dirname "$RESTIC_REPOSITORY")" ]; then
    echo "ERROR: Repository parent directory does not exist: $(dirname "$RESTIC_REPOSITORY")"
    exit 1
fi

# Export environment variables for restic
export RESTIC_REPOSITORY
export RESTIC_PASSWORD_FILE

# Initialize repository if it doesn't exist
if ! restic snapshots &>/dev/null; then
    echo "Initializing new restic repository..."
    restic init
    echo "Repository initialized successfully"
fi

# Build exclude arguments
EXCLUDE_ARGS=()
{% for exclude in restic_global_excludes %}
EXCLUDE_ARGS+=(--exclude "{{ exclude }}")
{% endfor %}

# Backup each enabled service
{% for service_name, service_config in restic_backup_services.items() %}
{% if service_config.enabled %}
echo ""
echo "Backing up {{ service_name }}..."
{% for path in service_config.paths %}
if [ -d "{{ path }}" ]; then
    restic backup \
        --tag="{{ service_name }}" \
        "${EXCLUDE_ARGS[@]}" \
{% for exclude in service_config.get('excludes', []) %}
        --exclude "{{ exclude }}" \
{% endfor %}
        "{{ path }}"
    echo "✓ {{ service_name }} backed up successfully"
else
    echo "⚠ Warning: {{ path }} does not exist, skipping"
fi
{% endfor %}
{% endif %}
{% endfor %}

# Prune old snapshots
echo ""
echo "Pruning old snapshots..."
restic forget \
    --keep-daily {{ restic_keep_daily }} \
    --keep-weekly {{ restic_keep_weekly }} \
    --keep-monthly {{ restic_keep_monthly }} \
    --prune

# Show repository statistics
echo ""
echo "Repository statistics:"
restic stats

echo ""
echo "=========================================="
echo "Restic backup completed: $(date)"
echo "=========================================="
