#!/usr/bin/env python3
import json
import ssl
import sys

import websocket

JSONRPC_URL = {{ truenas_jsonrpc_provision_url | to_json }}
TOKEN_FILE = {{ truenas_jsonrpc_provision_token_file | to_json }}
VALIDATE_CERTS = {{ truenas_jsonrpc_provision_api_validate_certs | bool | ternary('True', 'False') }}


class Client:
    def __init__(self):
        ssl_options = None if VALIDATE_CERTS else {"cert_reqs": ssl.CERT_NONE}
        self.connection = websocket.create_connection(JSONRPC_URL, sslopt=ssl_options)
        self.request_id = 1

    def call(self, method, params):
        request_id = self.request_id
        self.request_id += 1
        self.connection.send(json.dumps({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params}))
        while True:
            response = json.loads(self.connection.recv())
            if response.get("id") != request_id:
                continue
            if "error" in response:
                raise RuntimeError(response["error"])
            return response["result"]

    def query(self, method, field, value):
        return self.call(method, [[[field, "=", value]], {}])


def ensure_dataset(client, dataset, changes):
    found = client.query("pool.dataset.query", "id", dataset["name"])
    if not found:
        if not dataset.get("create", True):
            raise RuntimeError(f"Required dataset does not exist: {dataset['name']}")
        payload = {"name": dataset["name"], "type": "FILESYSTEM", "share_type": dataset.get("share_type", "GENERIC")}
        if dataset.get("encryption"):
            payload.update({"encryption": True, "inherit_encryption": False, "encryption_options": dataset["encryption_options"]})
        client.call("pool.dataset.create", [payload])
        changes.append(f"created dataset {dataset['name']}")
    for child in dataset.get("children", []):
        child_name = f"{dataset['name']}/{child.rsplit('/', 1)[-1]}"
        ensure_dataset(client, {"name": child_name, "share_type": dataset.get("share_type", "GENERIC")}, changes)


def ensure_user(client, user, changes):
    found = client.query("user.query", "username", user["username"])
    payload = {key: value for key, value in user.items() if key != "username"}
    if not found:
        payload.setdefault("group_create", True)
        client.call("user.create", [dict(payload, username=user["username"])])
        changes.append(f"created user {user['username']}")
        return
    current = found[0]
    updates = {}
    for key in ("full_name", "shell", "home", "sshpubkey", "smb"):
        if key in payload and current.get(key) != payload[key]:
            updates[key] = payload[key]
    if updates:
        client.call("user.update", [current["id"], updates])
        changes.append(f"updated user {user['username']}")


def ensure_keychain_credentials(client, credentials, changes):
    key_ids = {}
    public_keys = {}
    for credential in credentials:
        found = client.query("keychaincredential.query", "name", credential["name"])
        if found:
            key_ids[credential["name"]] = found[0]["id"]
            attributes = found[0].get("attributes", {})
            if attributes.get("public_key"):
                public_keys[credential["name"]] = attributes["public_key"]
            if credential["type"] == "SSH_CREDENTIALS":
                desired_attributes = dict(credential["attributes"])
                private_key_name = desired_attributes.pop("private_key_name", None)
                if private_key_name:
                    desired_attributes["private_key"] = key_ids[private_key_name]
                if any(attributes.get(key) != value for key, value in desired_attributes.items()):
                    client.call("keychaincredential.update", [found[0]["id"], {"attributes": desired_attributes}])
                    changes.append(f"updated keychain credential {credential['name']}")
            continue
        if credential.get("generate"):
            generated = client.call("keychaincredential.generate_ssh_key_pair", [])
            attributes = {
                "private_key": generated["private_key"],
                "public_key": generated["public_key"],
            }
        else:
            attributes = dict(credential["attributes"])
        private_key_name = attributes.pop("private_key_name", None)
        if private_key_name:
            attributes["private_key"] = key_ids[private_key_name]
        credential_id = client.call("keychaincredential.create", [{"name": credential["name"], "type": credential["type"], "attributes": attributes}])
        key_ids[credential["name"]] = credential_id
        if attributes.get("public_key"):
            public_keys[credential["name"]] = attributes["public_key"]
        changes.append(f"created keychain credential {credential['name']}")
    return key_ids, public_keys


def ensure_replication(client, replication, key_ids, changes):
    found = client.query("replication.query", "name", replication["name"])
    payload = dict(replication)
    preserve_existing_source_datasets = payload.pop("preserve_existing_source_datasets", False)
    credential_name = payload.pop("ssh_credentials_name", None)
    if credential_name:
        credential_id = key_ids[credential_name]
        if isinstance(credential_id, dict):
            credential_id = credential_id["id"]
        payload["ssh_credentials"] = int(credential_id)
    if not found:
        client.call("replication.create", [payload])
        changes.append(f"created replication task {replication['name']}")
        return
    current = found[0]
    if preserve_existing_source_datasets:
        existing_datasets = current.get("source_datasets", [])
        requested_datasets = payload.get("source_datasets", [])
        payload["source_datasets"] = list(dict.fromkeys(existing_datasets + requested_datasets))
    comparable = {key: value for key, value in payload.items() if key not in ("enabled",)}
    current_comparable = {key: current.get(key) for key in comparable}
    if current_comparable != comparable:
        client.call("replication.update", [current["id"], payload])
        changes.append(f"updated replication task {replication['name']}")


def scan_host_keys(client, scans, changes):
    for scan in scans:
        host_key = client.call("keychaincredential.remote_ssh_host_key_scan", [{
            "host": scan["host"],
            "port": int(scan.get("port", 22)),
            "connect_timeout": int(scan.get("connect_timeout", 10)),
        }])
        with open(scan["output_file"], "w", encoding="utf-8") as output_file:
            output_file.write(host_key.strip() + "\n")
        changes.append(f"scanned SSH host key for {scan['host']}")


def main():
    if len(sys.argv) != 2:
        raise ValueError("Usage: truenas-jsonrpc-provision.py POLICY_FILE")
    with open(sys.argv[1], encoding="utf-8") as policy_file:
        policy = json.load(policy_file)
    with open(TOKEN_FILE, encoding="utf-8") as token_file:
        token = token_file.read().strip()

    client = Client()
    try:
        client.call("auth.login_with_api_key", [token])
        changes = []
        for dataset in policy.get("datasets", []):
            ensure_dataset(client, dataset, changes)
        for user in policy.get("users", []):
            ensure_user(client, user, changes)
        key_ids, public_keys = ensure_keychain_credentials(client, policy.get("keychain_credentials", []), changes)
        public_key_output_file = policy.get("public_key_output_file")
        if public_key_output_file:
            public_key_name = policy["public_key_name"]
            with open(public_key_output_file, "w", encoding="utf-8") as output_file:
                output_file.write(public_keys[public_key_name].strip() + "\n")
        scan_host_keys(client, policy.get("host_key_scans", []), changes)
        for replication in policy.get("replications", []):
            ensure_replication(client, replication, key_ids, changes)
        for permission in policy.get("permissions", []):
            payload = {"path": permission["path"], "mode": permission["mode"], "options": permission["options"]}
            if permission.get("user"):
                payload.update({"user": permission["user"], "group": permission.get("group", permission["user"])})
            else:
                payload.update({"uid": int(permission["uid"]), "gid": int(permission["gid"])})
            client.call("filesystem.setperm", [payload])
            changes.append(f"set permissions {permission['path']}")
        for share in policy.get("shares", []):
            method = f"sharing.{share['type']}.query"
            key = "name" if share["type"] == "smb" else "path"
            value = share[key]
            if not client.query(method, key, value):
                payload = {"path": share["path"], "comment": share["comment"], "enabled": True}
                if share["type"] == "smb":
                    payload["name"] = share["name"]
                else:
                    payload["hosts"] = share["hosts"]
                client.call(f"sharing.{share['type']}.create", [payload])
                changes.append(f"created {share['type']} share {value}")
        for service in policy.get("services", []):
            configured = client.query("service.query", "service", service)[0]
            if not configured["enable"]:
                client.call("service.update", [service, {"enable": True}])
                changes.append(f"enabled service {service}")
            if not client.call("service.started", [service]):
                client.call("service.start", [service])
                changes.append(f"started service {service}")
        print("changed: " + ", ".join(changes) if changes else "unchanged")
    finally:
        client.connection.close()


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"TrueNAS JSON-RPC provisioning failed: {error}", file=sys.stderr)
        sys.exit(1)