version: "3.8"

services:
  unifi:
    image: docker.io/jacobalberty/unifi:latest
    container_name: unifi
    restart: always
    networks:
      - {{ podman_network }}
    ports:
      # Main GUI/API port (HTTPS) - localhost only, accessed via nginx proxy
      - "127.0.0.1:{{ unifi_port }}:{{ unifi_port_internal }}/tcp"
      # Device controller communication
      - "0.0.0.0:{{ unifi_device_port }}:{{ unifi_device_port }}/tcp"
      # STUN server (device discovery)
      - "0.0.0.0:{{ unifi_stun_port }}:{{ unifi_stun_port }}/udp"
      # Speed test
      - "0.0.0.0:{{ unifi_speedtest_port }}:{{ unifi_speedtest_port }}/tcp"
      # HTTP portal redirection
      - "0.0.0.0:{{ unifi_http_portal_port }}:{{ unifi_http_portal_port }}/tcp"
      # HTTPS portal redirection
      - "0.0.0.0:{{ unifi_https_portal_port }}:{{ unifi_https_portal_port }}/tcp"
      # AP discovery (broadcast on all interfaces)
      - "0.0.0.0:{{ unifi_ap_discovery_port }}:{{ unifi_ap_discovery_port }}/udp"
    volumes:
      - {{ unifi_config_dir }}:/unifi
    environment:
      - TZ={{ unifi_timezone }}
      - LOG_LEVEL={{ unifi_log_level }}
      # Set unprivileged port start to 0 to allow binding to ports < 1024 in rootless container
      - net.ipv4.ip_unprivileged_port_start=0
    healthcheck:
      test: ["CMD", "curl", "-f", "-k", "https://localhost:{{ unifi_port_internal }}/manage"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 300s

networks:
  {{ podman_network }}:
    external: true
